{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: train.py diffusion",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/lerobot/scripts/train.py",
            "console": "integratedTerminal",
            "args": [
                "--policy.type=diffusion",
                "--policy.device=cuda:1",
                "--num_workers=4",
                "--dataset.repo_id=saulbatman/videopo"
            ]
        },
        {
            "name": "Python Debugger: examples train_policy",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/train_policy.py",
            "console": "integratedTerminal",
            "args": [
            ]
        }
    ]
}